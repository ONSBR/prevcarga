#!/usr/bin/env Rscript
## prevcarga -- shim fino da CLI modular (M1.4): so despacho. Nenhum verbo e conhecido aqui; verbos entram
## por scripts/lib/cli/<verbo>.R (descobertos em prevcarga_main). Nao edite este arquivo para adicionar verbo.
##
## Ordem: localiza-se pelo --file=, carrega errors.R e runtime.R, resolve a raiz de instalacao, carrega
## config.R/banner.R/cli.R relativos a ela e delega a prevcarga_main() (runtime-first, handler de topo).

if (identical(environment(), globalenv())) {
  local({
    fa <- grep("^--file=", commandArgs(FALSE), value = TRUE)
    if (length(fa) != 1L) {
      writeLines(c("prevcarga: erro [runtime] (exit 7)", "o que: nao foi possivel localizar o script",
                   "onde: --file=", "como corrigir: rode a CLI pelo caminho do script scripts/prevcarga"),
                 con = stderr())
      quit(status = 7L, save = "no")
    }
    f <- gsub("\\", "/", sub("^--file=", "", fa), fixed = TRUE)
    lib <- file.path(dirname(normalizePath(f, winslash = "/", mustWork = FALSE)), "lib")
    options(prevcarga.lib = lib)
    for (m in c("errors.R", "runtime.R")) source(file.path(lib, m), local = FALSE)
    root <- prevcarga_install_root()
    for (m in c("config.R", "banner.R", "cli.R")) source(file.path(root, "scripts", "lib", m), local = FALSE)
    quit(status = prevcarga_main(commandArgs(TRUE), root = root), save = "no")
  })
}
