# ab-patch: mdir=holt-winters fonte_dia_O=passo1_do_fit_em_O
# hw_keep_step1.patch -- aplicado por scripts/tools/ab_oracle_run.sh SO na copia descartavel do oraculo (o oraculo segue byte-identico).
# Decisao do Gabriel (2026-10-31): descartar o passo 1 do fit em O esta errado; o A/B compara o dia O do clean-room com o passo 1 DO PROPRIO
# oraculo. hw_infer guarda o passo first_idx-1 de $mean (o dia O) pela mesma cadeia do horizonte (assemble + LOESS; SemiFer nao: o horizon_meta
# do oraculo comeca em O+1) e o run_pipeline.R --mode forecast grava esse dia como LONG proprio (first_forecast_day = O) em
# $AB_DAY0_DIR/<area>_<origin>.parquet. O LONG do harness fica byte-igual ao do oraculo sem patch.
--- a/models/holt-winters/R/inference/hw_inference.R
+++ b/models/holt-winters/R/inference/hw_inference.R
@@ -613,6 +613,16 @@
     message("[hw_inference] Step 3: p_Suaviza=FALSE; skipping LOESS smoothing.")
   }
 
+  # [prevcarga A/B: hw_keep_step1.patch -- SO na copia descartavel do ab_oracle_run.sh]
+  # O passo first_idx-1 de $mean (o dia O, previsao de datafimver+1) e calculado pelo fit e descartado acima.
+  # Aqui ele e MANTIDO como linha propria, pela mesma cadeia do horizonte: assemble + LOESS (p_Suaviza).
+  # SemiFer NAO se aplica: horizon_meta comeca em D = O+1 e nao tem FER/efeitoTemp do dia O.
+  previsao15_day0 <- NULL
+  if (first_idx >= 2L) {
+    previsao15_day0 <- .assemble_previsao15(artifact$fits_interval, 1L, first_idx - 1L)
+    if (p_Suaviza) previsao15_day0 <- .apply_loess_smoothing(previsao15_day0, 1L)
+  }
+
   # ── Step 4: Format output ─────────────────────────────────────────────────
