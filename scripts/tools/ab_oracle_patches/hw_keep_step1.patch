@@ -644,7 +654,8 @@
     model_id   = "HOLTW",
     area       = area,
     origin_day = origin_day,
-    n_steps    = n_steps
+    n_steps    = n_steps,
+    previsao15_day0 = previsao15_day0
   )
 }
 
--- a/models/holt-winters/run_pipeline.R
